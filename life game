# ------------- PLAYER -------------

class Player:
    def __init__(self):
        self.money = 50
        self.job = None
        self.house = HOUSES[0]
        self.happiness = 50  # 0–100
        self.status = 0
        self.inventory = []
        self.day = 1

    def apply_bonuses(self, bonuses):
        self.happiness = max(0, min(100, self.happiness + bonuses.get("happiness", 0)))
        self.status += bonuses.get("status", 0)

    def pay_rent(self):
        print(f"\nRent day! Your {self.house.name} costs £{self.house.rent}.")
        if self.money >= self.house.rent:
            self.money -= self.house.rent
            print(f"You paid rent. Money left: £{self.money}")
        else:
            print("You couldn't pay full rent. Your happiness drops.")
            self.happiness = max(0, self.happiness - 10)

    def show_stats(self):
        print("\n--- YOUR LIFE ---")
        print(f"Day: {self.day}")
        print(f"Money: £{self.money}")
        print(f"House: {self.house.name} (Rent: £{self.house.rent})")
        print(f"Happiness: {self.happiness}/100")
        print(f"Status: {self.status}")
        if self.job:
            print(f"Job: {self.job.name} (Performance: {self.job.performance}/100)")
        else:
            print("Job: Unemployed")
        print(f"Inventory: {[item.name for item in self.inventory] or 'Empty'}")
        print("-----------------\n")


# ------------- GAME LOGIC -------------

def choose_starting_job(player: Player):
    print(dedent("""
        You are starting your life with £50, a Tiny Studio, and no job.
        Choose one of three starting jobs:
    """))

    starting_jobs = [JOBS[0], JOBS[1], JOBS[2]]  # Fast Food, Dog Walker, Sephora
    for i, job in enumerate(starting_jobs, start=1):
        print(f"  {i}. {job.name} (Base salary: £{job.base_salary})")

    while True:
        choice = input("> ").strip()
        if choice.isdigit() and 1 <= int(choice) <= len(starting_jobs):
            player.job = starting_jobs[int(choice) - 1]
            print(f"You start working as a {player.job.name}.")
            break
        print("Invalid choice, try again.")


def go_to_work(player: Player):
    if not player.job:
        print("You don't have a job yet.")
        return

    salary = player.job.work_day()
    player.money += salary

    if player.job.is_fired():
        print("\nYour performance hit 0. You got fired.")
        player.job = None
    elif player.job.is_promotion_ready():
        print("\nYour performance hit 100! You are ready for a promotion or a better job.")
        upgrade_job(player)


def upgrade_job(player: Player):
    current_tier = player.job.tier if player.job else 0
    available = [job for job in JOBS if job.tier > current_tier and job.tier <= player.house.tier + 1]

    if not available:
        print("No better jobs available yet. Maybe upgrade your house or status.")
        return

    print("\nYou can choose a better job:")
    for i, job in enumerate(available, start=1):
        print(f"  {i}. {job.name} (Base salary: £{job.base_salary}, Tier: {job.tier})")

    choice = input("> ").strip()
    if choice.isdigit() and 1 <= int(choice) <= len(available):
        player.job = available[int(choice) - 1]
        print(f"You are now working as a {player.job.name}.")
    else:
        print("You stay in your current job for now.")


def visit_mall(player: Player):
    if player.money < 15:
        print("You don't really have enough money to enjoy the mall right now.")
        return

    print("\nYou go to the mall (Westgate‑style). You can visit up to 3 shops.")
    visits = 0
    while visits < 3:
        print("\nFloors:")
        print("  1. Ground Floor (Primark, Boots, TK Maxx)")
        print("  2. Middle Floor (River Island, Zara, Sephora)")
        print("  3. Top Floor (Apple, IKEA, Cinema, Café Nero)")
        print("  4. Leave the mall")

        floor_choice = input("> ").strip()
        if floor_choice == "4":
            break

        floor_map = {"1": "Ground Floor", "2": "Middle Floor", "3": "Top Floor"}
        if floor_choice not in floor_map:
            print("Invalid floor.")
            continue

        floor_name = floor_map[floor_choice]
        items = MALL_ITEMS[floor_name]
        print(f"\nYou are on the {floor_name}. Shops have these items:")

        for i, item in enumerate(items, start=1):
            print(f"  {i}. {item.name} (£{item.price}) [{item.category}] bonuses={item.bonuses}")
        print(f"  {len(items)+1}. Go back")

        choice = input("> ").strip()
        if not choice.isdigit():
            print("Invalid choice.")
            continue

        choice = int(choice)
        if choice == len(items) + 1:
            continue
        if not (1 <= choice <= len(items)):
            print("Invalid choice.")
            continue

        item = items[choice - 1]
        if player.money < item.price:
            print("You can't afford that.")
            continue

        player.money -= item.price
        player.inventory.append(item)
        player.apply_bonuses(item.bonuses)
        print(f"You bought {item.name}. Money left: £{player.money}")
        visits += 1

    print("You leave the mall.")


def upgrade_house(player: Player):
    print("\nAvailable houses:")
    for i, house in enumerate(HOUSES, start=1):
        owned = "(current)" if house is player.house else ""
        print(f"  {i}. {house.name} – Rent £{house.rent}, Tier {house.tier} {owned}")

    print("Choose a house to move into (or press Enter to cancel):")
    choice = input("> ").strip()
    if not choice:
        return
    if not choice.isdigit() or not (1 <= int(choice) <= len(HOUSES)):
        print("Invalid choice.")
        return

    new_house = HOUSES[int(choice) - 1]
    if new_house is player.house:
        print("You already live here.")
        return

    cost = new_house.rent * 3  # upfront cost
    print(f"Moving into {new_house.name} will cost an upfront £{cost}. Continue? (y/n)")
    confirm = input("> ").strip().lower()
    if confirm != "y":
        return

    if player.money < cost:
        print("You can't afford to move.")
        return

    player.money -= cost
    player.house = new_house
    print(f"You moved into {new_house.name}. Money left: £{player.money}")


def take_vacation(player: Player):
    print("\nWhere would you like to go on vacation?")
    for i, (name, base_cost, bonuses) in enumerate(VACATIONS, start=1):
        print(f"  {i}. {name} – Base cost £{base_cost}, bonuses={bonuses}")
    print("  0. Cancel")

    choice = input("> ").strip()
    if not choice.isdigit() or not (0 <= int(choice) <= len(VACATIONS)):
        print("Invalid choice.")
        return
    if choice == "0":
        return

    vacation = VACATIONS[int(choice) - 1]

    print("\nChoose flight class:")
    for i, (cls, extra_cost, bonuses) in enumerate(FLIGHT_CLASSES, start=1):
        print(f"  {i}. {cls} – Extra £{extra_cost}, bonuses={bonuses}")
    cls_choice = input("> ").strip()
    if not cls_choice.isdigit() or not (1 <= int(cls_choice) <= len(FLIGHT_CLASSES)):
        print("Invalid choice.")
        return

    flight = FLIGHT_CLASSES[int(cls_choice) - 1]

    total_cost = vacation[1] + flight[1]
    print(f"\nTotal cost: £{total_cost}. Continue? (y/n)")
    confirm = input("> ").strip().lower()
    if confirm != "y":
        return

    if player.money < total_cost:
        print("You can't afford this vacation.")
        return

    player.money -= total_cost
    bonuses = {}
    for k, v in vacation[2].items():
        bonuses[k] = bonuses.get(k, 0) + v
    for k, v in flight[2].items():
        bonuses[k] = bonuses.get(k, 0) + v

    player.apply_bonuses(bonuses)
    print(f"You went on vacation to {vacation[0]} in {flight[0]} class!")
    print(f"Bonuses applied: {bonuses}")
    print(f"Money left: £{player.money}, Happiness: {player.happiness}, Status: {player.status}")


def check_win_lose(player: Player):
    if player.happiness <= 0:
        print("\nYou burned out. Game over.")
        return True
    if player.money >= 1_000_000 and player.house is HOUSES[-1] and player.status >= 50:
        print("\nYou made it: millionaire, luxury home, high status. You win at life!")
        return True
    return False


def main_loop():
    player = Player()
    print(dedent("""
        ------------------------------------
        WELCOME TO LIFE MALL SIM (TEXT EDITION)
        ------------------------------------
        You start poor, in a tiny studio, with £50.
        Work, shop, upgrade your home, travel, and try not to get fired.
    """))

    choose_starting_job(player)

    while True:
        player.show_stats()
        print("What do you want to do today?")
        print("  1. Go to work")
        print("  2. Visit the mall")
        print("  3. Upgrade / change house")
        print("  4. Go on vacation")
        print("  5. Skip day / rest")
        print("  6. Quit game")

        choice = input("> ").strip()
        if choice == "1":
            go_to_work(player)
        elif choice == "2":
            visit_mall(player)
        elif choice == "3":
            upgrade_house(player)
        elif choice == "4":
            take_vacation(player)
        elif choice == "5":
            print("You take a quiet day. Slight happiness boost.")
            player.happiness = min(100, player.happiness + 2)
        elif choice == "6":
            print("Thanks for playing!")
            sys.exit(0)
        else:
            print("Invalid choice.")

        # Rent every 7 days
        if player.day % 7 == 0:
            player.pay_rent()

        if check_win_lose(player):
            break

        player.day += 1


if __name__ == "__main__":
    main_loop()
