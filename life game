# ------------- DATA MODELS -------------

class Job:
    def __init__(self, name, base_salary, tier, choices):
        """
        choices: list of (description, effect) where effect in {"good", "neutral", "bad"}
        """
        self.name = name
        self.base_salary = base_salary
        self.tier = tier
        self.choices = choices
        self.performance = 50  # 0–100

    def work_day(self):
        print(f"\nYou go to work at {self.name}.")
        print(f"Current performance: {self.performance}/100")
        print("Choose what you do today:")

        for i, (desc, effect) in enumerate(self.choices, start=1):
            print(f"  {i}. {desc}")

        choice = input("> ").strip()
        if not choice.isdigit() or not (1 <= int(choice) <= len(self.choices)):
            print("You hesitate and do nothing. Your manager is not impressed.")
            self._apply_effect("bad")
            return 0

        _, effect = self.choices[int(choice) - 1]
        self._apply_effect(effect)

        # Salary is slightly boosted by performance
        salary = int(self.base_salary * (0.5 + self.performance / 200))
        print(f"You earn £{salary} today.")
        return salary

    def _apply_effect(self, effect):
        if effect == "good":
            delta = random.randint(8, 15)
            print("Great choice! Your performance improves.")
        elif effect == "neutral":
            delta = random.randint(-3, 3)
            print("An okay day. Not great, not terrible.")
        else:
            delta = -random.randint(8, 15)
            print("Oof. That was not a good move at work.")

        self.performance = max(0, min(100, self.performance + delta))
        print(f"New performance: {self.performance}/100")

    def is_fired(self):
        return self.performance <= 0

    def is_promotion_ready(self):
        return self.performance >= 100


class House:
    def __init__(self, name, rent, tier, furniture_slots):
        self.name = name
        self.rent = rent
        self.tier = tier
        self.furniture_slots = furniture_slots


class Item:
    def __init__(self, name, price, category, bonuses):
        """
        bonuses: dict like {"happiness": +5, "performance": +3}
        category: "clothes", "furniture", "electronics", "essential", "entertainment"
        """
        self.name = name
        self.price = price
        self.category = category
        self.bonuses = bonuses


